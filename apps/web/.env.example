# Names only. Real values live in Railway / a local .env that is never committed.
CHAIN=mock                 # mock (simulation) | solana (after the escrow program is deployed)
DATABASE_URL=              # Railway Postgres. Empty = embedded PGlite in ./.data (local dev)
PUBLIC_URL=                # e.g. https://narrativepad.up.railway.app (defaults to RAILWAY_PUBLIC_DOMAIN)
HELIUS_API_KEY=            # only for CHAIN=solana
TEAM_WALLETS=              # comma-separated team wallets, flagged in the UI if they deposit
PUMP_RPC_URL=              # mainnet RPC for reading pump.fun's pair list (read-only). Empty = public RPC

# Timings (seconds) and limits (SOL). Defaults shown.
VOTE_DURATION_SEC=180
DEPOSIT_WINDOW_SEC=600
LAUNCH_DELAY_SEC=120
LAUNCH_WINDOW_SEC=1800
TRANCHE_COUNT=5
TRANCHE_INTERVAL_SEC=300
POOL_CAP_SOL=20
POOL_MIN_SOL=1
PER_WALLET_MAX_SOL=2
MIN_DEPOSIT_SOL=0.05
FEE_BPS=100
